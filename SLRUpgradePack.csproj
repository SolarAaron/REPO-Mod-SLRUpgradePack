<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <Authors>SolarAaron</Authors>
        <Version>1.0.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Add Package Sources -->
    <PropertyGroup>
        <EnableGameReferences>true</EnableGameReferences>
        <DefaultItemExcludes>$(DefaultItemExcludes);Assets/**</DefaultItemExcludes>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>
    <PropertyGroup>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json; <!-- Official NuGet feed -->
            https://nuget.bepinex.dev/v3/index.json; <!-- BepInEx NuGet feed -->
        </RestoreAdditionalProjectSources>
    </PropertyGroup>

    <!-- Package References -->
    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" IncludeAssets="build"/>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.0"/>
        <PackageReference Include="Linkoid.Repo.Plugin.Build" Version="0.2.2" PrivateAssets="all"/>

        <PackageReference Include="BepInEx.Core" Version="5.4.21" ExcludeAssets="runtime"/>
        <PackageReference Include="UnityEngine.Modules" Version="2022.3.21" IncludeAssets="compile" PrivateAssets="all"/>
        <PackageReference Include="Zehs.REPOLib" Version="4.2.0"/>
    </ItemGroup>
    <ItemGroup>
        <Folder Include="package\skel\plugins\"/>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="KeybindLib">
            <HintPath>..\..\.config\r2modmanPlus-local\REPO\profiles\Test\BepInEx\plugins\BULLETBOT-KeybindLib\KeybindLib.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Photon3Unity3D">
            <HintPath>..\..\.steam\steam\steamapps\common\REPO\REPO_Data\Managed\Photon3Unity3D.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="PhotonRealtime">
            <HintPath>..\..\.steam\steam\steamapps\common\REPO\REPO_Data\Managed\PhotonRealtime.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Facepunch.Steamworks.Win64">
            <HintPath>..\..\.steam\steam\steamapps\common\REPO\REPO_Data\Managed\Facepunch.Steamworks.Win64.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <!-- Package staging files are not runtime plugin payloads; keep them out of the profile. -->
    <ItemGroup>
        <None Update="package/**/*">
            <CopyToPluginOutputDirectory>Never</CopyToPluginOutputDirectory>
        </None>
    </ItemGroup>

    <!-- The plugin build targets copy current outputs but leave renamed/removed
         assemblies behind in the profile's plugin directory. -->
    <Target Name="RemoveStalePluginAssemblies"
            BeforeTargets="CopyFilesToPluginOutputDirectory"
            DependsOnTargets="GetCopyToPluginOutputItems"
            Condition="'$(PluginOutputDirectory)' != ''">
        <ItemGroup>
            <_ExistingPluginAssemblies Include="$(PluginOutputDirectory)**/*.dll"/>
            <_ExpectedPluginAssemblies Include="@(CopyToPluginOutputItems-&gt;'$(PluginOutputDirectory)%(TargetPath)')"
                                       Condition="'%(CopyToPluginOutputItems.Extension)' == '.dll'"/>
            <_StalePluginAssemblies Include="@(_ExistingPluginAssemblies)"
                                    Exclude="@(_ExpectedPluginAssemblies)"/>
        </ItemGroup>
        <Delete Files="@(_StalePluginAssemblies)"/>
    </Target>
</Project>
